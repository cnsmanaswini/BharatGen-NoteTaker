# Copy to .env and adjust. Never commit .env.
# "chrome" uses your installed Google Chrome (recommended, Google sign-in often
# blocks bundled Chromium). Leave empty to use Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome
HEADLESS=false
USER_DATA_DIR=./browser_profile
BOT_DISPLAY_NAME=BharatGen Notetaker
LOG_LEVEL=INFO
LOG_DIR=./logs
DEFAULT_TIMEOUT_MS=30000
AUTH_WAIT_TIMEOUT_S=600
# Leave after ALONE_TIMEOUT_S seconds with <= ALONE_PARTICIPANT_LIMIT people (0 = never).
ALONE_TIMEOUT_S=120
ALONE_PARTICIPANT_LIMIT=1
RECONNECT_TIMEOUT_S=60

# Concurrent orchestration (one worker process + Chromium per meeting).
MAX_CONCURRENT_MEETINGS=3
WORKER_STARTUP_TIMEOUT_S=120
WORKER_SHUTDOWN_TIMEOUT_S=15
# Each session clones PROFILE_SOURCE into PROFILES_DIR/<meeting_id> so Chromium
# never opens one profile directory twice. Set PROFILE_CLONE=false to start each
# session with a fresh (signed-out) profile instead.
PROFILES_DIR=./profiles
PROFILE_SOURCE=./browser_profile
PROFILE_CLONE=true
ALLOW_DUPLICATE_MEETINGS=false

# Audio capture (off by default). loopback captures what the PC plays (Windows
# WASAPI); synthetic is the built-in self-test tone.
AUDIO_ENABLED=false
AUDIO_SOURCE=loopback
# Optional substring of an output device name, e.g. a virtual cable.
AUDIO_DEVICE=
FFMPEG_PATH=ffmpeg
AUDIO_CHUNK_MS=500
AUDIO_OUTPUT_DIR=./audio
AUDIO_SAVE_WAV=true
